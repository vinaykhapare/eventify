# Server Port (used for local development; ignored by Vercel serverless)
PORT=5000

# MongoDB Atlas connection string
# IMPORTANT: In MongoDB Atlas Network Access, add 0.0.0.0/0 so Vercel dynamic IPs can connect
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/eventify?retryWrites=true&w=majority

# JWT secret key (use a secure random string of at least 32 characters)
JWT_SECRET=your_jwt_secret_key_min_32_chars

# Cloudinary credentials for event banner image uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL for CORS allowlist (e.g., https://eventify-eight-swart.vercel.app or http://localhost:5173)
CLIENT_URL=http://localhost:5173
